DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
COLLECT_SECRET=
# 你自己的 Discord 使用者 ID（開發者模式開啟後右鍵自己的頭像/名稱 → 複製使用者 ID）。/抓圖刪除跟
# 🗑️ 按鈕不用密鑰就能刪資料，只認這個 ID——不設的話兩個都會直接擋掉所有人，不會留安全空窗期。
OWNER_DISCORD_ID=
PORT=8787
# 選填：不設就用本機檔案存 collected.json（Render 免費方案重啟會清空，見 README）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 選填：設了才會在 userscript 本機開關打開時，主動把新收藏推播過去——兩個都設就兩邊都發，只設一個
# 就只發那邊。bot 要先被邀進對應伺服器且有發言權限（一般 bot 邀請連結，不是 User Install），見 README。
TEXT_ANNOUNCE_CHANNEL_ID=
MARUNA_ANNOUNCE_CHANNEL_ID=
# 選填：設了三個才會讓 POST /admin/backup 生效——把 collected.json 現況快照到另一個 GitHub repo 當
# Upstash 的備援。GITHUB_BACKUP_TOKEN 要是對目標 repo 有 contents 讀寫權限的 PAT，GITHUB_BACKUP_REPO
# 是 "owner/repo"，GITHUB_BACKUP_PATH 不設則預設寫到 repo 根目錄的 collected_backup.json。
GITHUB_BACKUP_TOKEN=
GITHUB_BACKUP_REPO=
GITHUB_BACKUP_PATH=
